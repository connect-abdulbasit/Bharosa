# Copy to .env. All values below are FAKE and for local prototype use only.

# --- AI ---
# stub | real
AI_MODE=stub
# OPTIONAL. AI_MODE=real works without a key (offline parser, reason 'llm_unavailable'). To enable the LLM: set LLM_API_KEY and
# LLM_MODEL (and LLM_BASE_URL if not the default), then RESTART. No code change.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# what "this month" means in claim speech (YYYY-MM); the demo data is for 2026-10. Empty = the calendar month
AI_DEFAULT_PERIOD=2026-10

# --- Backend ---
DATABASE_URL=postgresql+psycopg2://bharosa:bharosa@localhost:5432/bharosa
JWT_SECRET=dev-only-change-me-not-for-production-0000
# docker: seed fake demo data after migrations (idempotent)
SEED_ON_START=1
BCRYPT_ROUNDS=12
# where ID photos are stored (default backend/uploads; /data/uploads in Docker)
UPLOAD_DIR=
MAX_UPLOAD_BYTES=10485760
# ID photos are stored in Postgres after a server-side resize (max side px, JPEG quality, stored size cap in bytes)
DOCUMENT_MAX_SIDE=1280
DOCUMENT_JPEG_QUALITY=80
MAX_DOCUMENT_BYTES=2097152
# 1 = also keep a local copy in UPLOAD_DIR as a cache (the database is the source of truth)
DOCUMENT_DISK_CACHE=0

# 1 enables POST /admin/demo/reset and the demo chaos switches (the 6 demo scenarios). Set 0 for real use.
DEMO_MODE=1
# docker compose only: MOCKS_URL for the backend container. Empty = built-in fake mocks (needed by the 6 demo scenarios).
# BACKEND_MOCKS_URL=

# --- optional services app (/services): in-app Urdu/English messages on status changes (needs the citizen's notifications consent)
# and signed webhooks. Empty = off. docker compose sets both to http://services:8002 by default.
NOTIFICATIONS_URL=
WEBHOOKS_URL=
SERVICES_API_KEY=dev-services-key-not-for-production

# --- background claim pipeline
# thread: in-process worker + jobs table | inline: run inside the request (tests)
PIPELINE_MODE=thread
JOB_POLL_SECONDS=1.0
# a job stuck 'running' this long is re-queued after a restart
JOB_STALE_SECONDS=300

# --- rate limiting (format N/minute|second|hour)
# Login attempts per client IP on /auth/login. UNSET = 5/minute, or 30/minute while DEMO_MODE=1
# (the demo logs in as many different users from one IP). Set it to override both, e.g. LOGIN_RATE_LIMIT=10/minute
# LOGIN_RATE_LIMIT=5/minute
# per client IP, everything else
DEFAULT_RATE_LIMIT=120/minute
# per API key, /public routes
PUBLIC_RATE_LIMIT=30/minute
# 1 behind Render/Railway: use X-Forwarded-For for the client IP
TRUST_PROXY=0

# --- monitoring / deploy
ENVIRONMENT=dev
LOG_LEVEL=INFO
# optional; needs sentry-sdk (pip install 'bharosa-backend[monitoring]')
SENTRY_DSN=
# default ai/eval/eval_results.json (included in GET /eval when present)
EVAL_RESULTS_PATH=
PORT=8000
WEB_CONCURRENCY=1
# FAKE 4-digit PIN given to every seeded citizen (helper consent grants)
DEMO_CITIZEN_PIN=1234
# empty -> backend uses fake_mocks_client
MOCKS_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000

# --- Demo users (username = role name). Clearly fake. ---
DEMO_CITIZEN_PASSWORD=citizen-demo-123
DEMO_HELPER_PASSWORD=helper-demo-123
DEMO_OFFICER_PASSWORD=officer-demo-123
DEMO_ADMIN_PASSWORD=admin-demo-123
DEMO_AUDITOR_PASSWORD=auditor-demo-123

# --- Postgres (docker-compose) ---
POSTGRES_USER=bharosa
POSTGRES_PASSWORD=bharosa
POSTGRES_DB=bharosa

# --- Frontend ---
# fixtures | live
NEXT_PUBLIC_API_MODE=fixtures
NEXT_PUBLIC_API_URL=http://localhost:8000
# POSTGRES_PORT=5432             # host port; change if 5432 is taken
