# Bharosa environment. Copy to .env (git-ignored) and edit: cp .env.example .env
# Every value here is FAKE or blank; secrets are left blank. Comments are always on their own line.
# docker compose reads .env for the ${...} values in docker-compose.yml AND passes it to the backend container.
# Lines starting with "# KEY=" are optional: uncomment to change the default shown.

# ======================================================================================================================
# Postgres (docker compose only)
# ======================================================================================================================
# Database user created in the postgres container.
POSTGRES_USER=bharosa
# Database password for the postgres container. Use a strong random value in .env.
POSTGRES_PASSWORD=
# Database name created in the postgres container.
POSTGRES_DB=bharosa
# Host port the postgres container is published on (the container always uses 5432). Pick a free one if 5432 is busy.
POSTGRES_PORT=5432

# ======================================================================================================================
# Backend (FastAPI): core
# ======================================================================================================================
# SQLAlchemy URL of the database. Inside docker compose this is overridden with the service name postgres:5432.
DATABASE_URL=postgresql+psycopg2://bharosa:bharosa@localhost:5432/bharosa
# Secret that signs login tokens (JWT). REQUIRED in production: a long random value. The code default is only for dev.
JWT_SECRET=
# How long a login token lives, in seconds.
# JWT_EXPIRES_SECONDS=3600
# bcrypt cost for password hashing (lower is faster, only for tests).
# BCRYPT_ROUNDS=12
# Label shown in /health and logs (dev | production).
ENVIRONMENT=dev
# Log level (DEBUG, INFO, WARNING).
# LOG_LEVEL=INFO
# Optional Sentry DSN for error reporting. Blank = off.
SENTRY_DSN=
# Browser origins the API accepts, comma separated (the frontend origin).
CORS_ORIGINS=http://localhost:3000
# 1 behind Render/Railway so rate limits use the real client IP (X-Forwarded-For).
TRUST_PROXY=0
# Port the backend container listens on (Render sets it).
# PORT=8000
# Number of uvicorn workers.
# WEB_CONCURRENCY=1
# 1 = seed the FAKE demo users, cases and scenarios after migrations on every start (idempotent).
SEED_ON_START=1
# 1 = demo reset endpoint, outage switches and a relaxed login limit. Set 0 for real use.
DEMO_MODE=1
# FAKE 4-digit PIN of every seeded citizen (helpers need it to grant consent for them).
DEMO_CITIZEN_PIN=1234
# Password of the demo users citizen, s1-clean ... s7-autohandle and demo-live. Set your own strong value in .env.
DEMO_CITIZEN_PASSWORD=
# Password of the demo helper. Set your own strong value in .env.
DEMO_HELPER_PASSWORD=
# Password of the demo officer. Set your own strong value in .env.
DEMO_OFFICER_PASSWORD=
# Password of the demo admin. Set your own strong value in .env.
DEMO_ADMIN_PASSWORD=
# Password of the demo auditor. Set your own strong value in .env.
DEMO_AUDITOR_PASSWORD=
# Path of the shared demo people file (default contracts/fixtures/demo_people.json).
# DEMO_PEOPLE_PATH=
# Folder with the contract fixtures the backend serves (default contracts/fixtures).
# FIXTURES_DIR=
# Offline model evaluation file shown in GET /eval (default ai/eval/eval_results.json).
# EVAL_RESULTS_PATH=

# ======================================================================================================================
# Backend: claim pipeline and rate limits
# ======================================================================================================================
# thread = in-process worker and a jobs table (default). inline = run inside the request (tests only).
PIPELINE_MODE=thread
# Seconds between job-queue polls of the background worker.
# JOB_POLL_SECONDS=1.0
# A job stuck in "running" this long is re-queued at the next start (seconds).
# JOB_STALE_SECONDS=300
# Login attempts per client IP. Blank = 5/minute, or 30/minute while DEMO_MODE=1. Format N/second|minute|hour.
# LOGIN_RATE_LIMIT=
# Requests per client IP for everything else.
# DEFAULT_RATE_LIMIT=120/minute
# Requests per API key on the /public routes.
# PUBLIC_RATE_LIMIT=30/minute

# ======================================================================================================================
# Backend: ID photos and uploads
# ======================================================================================================================
# Folder for the optional local photo cache. Blank = backend/uploads (the container uses /data/uploads).
# UPLOAD_DIR=
# Largest photo upload accepted, in bytes (10 MB).
# MAX_UPLOAD_BYTES=10485760
# Photos are shrunk to this many pixels on the longest side.
# DOCUMENT_MAX_SIDE=1280
# JPEG quality of the stored photo (1-95).
# DOCUMENT_JPEG_QUALITY=80
# Largest stored photo in bytes (2 MB, also a database constraint).
# MAX_DOCUMENT_BYTES=2097152
# 1 = also keep a copy of every photo in UPLOAD_DIR (the database stays the source of truth).
# DOCUMENT_DISK_CACHE=0

# ======================================================================================================================
# Backend to other services (mocks, notifications, webhooks)
# ======================================================================================================================
# URL of the mocks service for a backend running on the host. Blank = the built-in fake mocks client.
MOCKS_URL=http://localhost:8001
# docker compose only: the mocks URL the backend CONTAINER uses (service name). Blank = built-in fake mocks.
BACKEND_MOCKS_URL=http://mocks:8001
# Only if CHAOS_TOKEN is set on the mocks: the same value, so the Chaos Panel may switch failures on and off.
# MOCKS_CHAOS_TOKEN=
# URL of the services app for in-app Urdu/English messages. Blank = off. Compose default http://services:8002.
NOTIFICATIONS_URL=http://services:8002
# URL of the services app for signed webhooks. Blank = off. Compose default http://services:8002.
WEBHOOKS_URL=http://services:8002
# Shared secret between the backend and the services app (X-Service-Key). Use the SAME value for both.
SERVICES_API_KEY=
# Seconds the backend waits for the services app before giving up (it never blocks a claim).
# SERVICES_TIMEOUT_SECONDS=3

# ======================================================================================================================
# AI package (runs inside the backend)
# ======================================================================================================================
# stub = fixed demo outputs. real = the real AI functions, which work offline without an LLM key.
AI_MODE=stub
# What "this month" means in spoken claims (YYYY-MM). The demo data is for 2026-10. Blank = the calendar month.
AI_DEFAULT_PERIOD=2026-10
# OPTIONAL LLM key (extract_claim only). Paste your LLM API key here, then restart. Blank = offline parser (reason llm_unavailable).
LLM_API_KEY=
# The provider's model id. REQUIRED together with the key; there is no default.
LLM_MODEL=
# OpenAI-compatible API base URL, https only. Blank = https://api.x.ai/v1.
LLM_BASE_URL=
# 0 forces the offline parser even when a key is set.
# AI_USE_LLM=1
# 0 switches the scam text model off (rules only).
# AI_USE_ML=1
# 0 switches OCR of the ID photo off (quality check only).
# AI_USE_OCR=1
# Force one OCR engine: rapidocr or tesseract. Blank = the first installed.
# AI_OCR_ENGINE=
# Tesseract languages. Blank = English plus Urdu when both packs are installed (the Docker image has both).
# AI_OCR_LANG=
# Evaluation script only: price per 1M tokens used for the cost report.
# LLM_PRICE_PER_1M_TOKENS=

# ======================================================================================================================
# Mocks service (simulated identity, ledger, payments)
# ======================================================================================================================
# Optional guard for POST /chaos on the mocks. Blank = open (needed by make demo-scenarios and the e2e tests, which send no token).
# CHAOS_TOKEN=

# ======================================================================================================================
# Services app (notifications, webhooks, Digital Twin)
# ======================================================================================================================
# The services app reads MOCKS_URL (above) to send the mock SMS; compose sets http://mocks:8001 for it. No extra variable.
# 1 = webhook targets may be local addresses (demos and e2e). 0 = public https hosts only (SSRF guard).
WEBHOOKS_ALLOW_LOCAL=0
# Digital Twin: admin username (default admin).
# TWIN_ADMIN=admin
# Digital Twin: admin password (default admin-demo-123; set it to your DEMO_ADMIN_PASSWORD).
# TWIN_ADMIN_PASSWORD=

# ======================================================================================================================
# Scripts and end-to-end tests
# ======================================================================================================================
# e2e and the Digital Twin: backend URL (default http://localhost:8000).
# BASE=http://localhost:8000
# e2e: services app URL (default http://localhost:8002).
# SERVICES_URL=http://localhost:8002
# make demo-scenarios: where the mocks are reachable from the host (default http://localhost:8001).
# MOCKS_HOST_URL=http://localhost:8001
# Postgres-only audit trigger test: a throwaway database URL.
# TEST_POSTGRES_URL=

# ======================================================================================================================
# Frontend (Next.js). Put these in frontend/.env.local, they are baked in at build time
# ======================================================================================================================
# fixtures = no backend needed (default). live = call the backend API.
NEXT_PUBLIC_API_MODE=fixtures
# Backend base URL the browser calls in live mode (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000
