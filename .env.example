# Copy to .env. All values below are FAKE and for local prototype use only.

# --- AI ---
# stub | real
AI_MODE=stub
# only needed when AI_MODE=real (Ali)
LLM_API_KEY=

# --- Backend ---
DATABASE_URL=postgresql+psycopg2://bharosa:bharosa@localhost:5432/bharosa
JWT_SECRET=dev-only-change-me-not-for-production-0000
# docker: seed fake demo data after migrations (idempotent)
SEED_ON_START=1
BCRYPT_ROUNDS=12
# where ID photos are stored (default backend/uploads; /data/uploads in Docker)
UPLOAD_DIR=
MAX_UPLOAD_BYTES=5242880

# --- background claim pipeline
# thread: in-process worker + jobs table | inline: run inside the request (tests)
PIPELINE_MODE=thread
JOB_POLL_SECONDS=1.0
# a job stuck 'running' this long is re-queued after a restart
JOB_STALE_SECONDS=300

# --- rate limiting (format N/minute|second|hour)
# per client IP, /auth/login
LOGIN_RATE_LIMIT=5/minute
# per client IP, everything else
DEFAULT_RATE_LIMIT=120/minute
# per API key, /public routes
PUBLIC_RATE_LIMIT=30/minute
# 1 behind Render/Railway: use X-Forwarded-For for the client IP
TRUST_PROXY=0

# --- monitoring / deploy
ENVIRONMENT=dev
LOG_LEVEL=INFO
# optional; needs sentry-sdk (pip install 'bharosa-backend[monitoring]')
SENTRY_DSN=
# default ai/eval/eval_results.json (included in GET /eval when present)
EVAL_RESULTS_PATH=
PORT=8000
WEB_CONCURRENCY=1
# FAKE 4-digit PIN given to every seeded citizen (helper consent grants)
DEMO_CITIZEN_PIN=1234
# empty -> backend uses fake_mocks_client
MOCKS_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000

# --- Demo users (username = role name). Clearly fake. ---
DEMO_CITIZEN_PASSWORD=citizen-demo-123
DEMO_HELPER_PASSWORD=helper-demo-123
DEMO_OFFICER_PASSWORD=officer-demo-123
DEMO_ADMIN_PASSWORD=admin-demo-123
DEMO_AUDITOR_PASSWORD=auditor-demo-123

# --- Postgres (docker-compose) ---
POSTGRES_USER=bharosa
POSTGRES_PASSWORD=bharosa
POSTGRES_DB=bharosa

# --- Frontend ---
# fixtures | live
NEXT_PUBLIC_API_MODE=fixtures
NEXT_PUBLIC_API_URL=http://localhost:8000
# POSTGRES_PORT=5432             # host port; change if 5432 is taken
