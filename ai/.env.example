# Copy to ai/.env (git-ignored) for local runs of `python ai/eval/run_eval.py --llm`. Never put a real value in this file.
# The LLM is OPTIONAL: with no key, no model, or AI_USE_LLM=0 every function runs offline.
# The package itself never reads ai/.env: the backend (or your shell) must put these in the process environment.
LLM_API_KEY=
# the model id for your provider (required, no default)
LLM_MODEL=
# any OpenAI-compatible chat-completions API, https only. Empty = https://api.x.ai/v1
LLM_BASE_URL=
# 0 forces the offline parser
AI_USE_LLM=1
# what "this month" means in claim speech (YYYY-MM); empty = the calendar month
AI_DEFAULT_PERIOD=2026-10
